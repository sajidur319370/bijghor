# InfinityFree (no access to the web root setting): send every request into public/.
# Uploaded to htdocs/.htaccess, next to artisan.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Second line of defence: never serve these directly, even if rewriting were off
<FilesMatch "^(\.env.*|composer\.(json|lock)|artisan|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

Options -Indexes
